{
  "name": "diskarte-monorepo",
  "private": true,
  "description": "Diskarte \u2014 the Next.js app (diskarte/, deployed on Render) and its Supabase migrations (supabase/)",
  "scripts": {
    "install:all": "npm ci --prefix diskarte",
    "postinstall": "npm run install:all",
    "dev": "npm run dev --prefix diskarte",
    "build": "npm run build --prefix diskarte",
    "lint": "npm run lint --prefix diskarte",
    "typecheck": "npm run typecheck --prefix diskarte",
    "test": "npm test --prefix diskarte",
    "test:e2e": "npm run test:e2e --prefix diskarte",
    "brand:assets": "npm run brand:assets --prefix diskarte",
    "admin:grant": "npm run admin:grant --prefix diskarte --"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
