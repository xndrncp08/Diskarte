# ---------------------------------------------------------------------------------------
# Diskarte Early Access portal — runtime configuration (copy to .env)
# ---------------------------------------------------------------------------------------

# Same Supabase project as the Diskarte app (Project Settings → API).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only. Needed to create accounts for approved applicants. Never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URLs: this portal, and the Diskarte app approved users log in to.
SITE_URL=http://localhost:3100
APP_URL=http://localhost:3000

# 32+ random characters: signs form tokens and salts IP hashes. `openssl rand -base64 48`
PORTAL_SECRET=change-me-to-a-long-random-string-0000000000

# Email: resend (production), file (writes JSON to EMAIL_OUTBOX_DIR — tests) or log (dev).
EMAIL_TRANSPORT=log
RESEND_API_KEY=
EMAIL_FROM=Diskarte <early-access@your-domain.ph>
EMAIL_OUTBOX_DIR=

# Optional Cloudflare Turnstile (set both or neither).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional limits (per client IP).
RATE_LIMIT_APPLY_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_MINUTE=5
