# =====================================================================
# Diskarte environment variables
# Copy to .env.local for `npm run dev`, or set them on your host (Render).
# All values are read at RUNTIME, so one Docker image works everywhere.
# =====================================================================

# --- Supabase (Project Settings → API) ---------------------------------
# Public project URL and anon/publishable key. Safe to expose to browsers;
# Row-Level Security in supabase/migrations protects the data.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# --- LiveKit (LiveKit Cloud → Settings → Keys) ---------------------------
# WebSocket URL of your LiveKit project (public).
LIVEKIT_URL=wss://your-project.livekit.cloud
# API key + secret used ONLY on the server to mint short-lived room tokens.
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- App -----------------------------------------------------------------
# Public base URL (used for OAuth redirects, invite links and OG metadata).
# On Render this falls back to RENDER_EXTERNAL_URL automatically.
SITE_URL=http://localhost:3000
# Optional comma-separated extra origins allowed to call /api/* (CORS + CSRF allow-list).
# EARLY_ACCESS_URL below is always included.
ALLOWED_ORIGINS=
# Optional rate limits (per client IP, per minute): auth attempts (default 5) and /api/* calls (default 120).
RATE_LIMIT_AUTH_PER_MINUTE=
RATE_LIMIT_API_PER_MINUTE=
# Optional: share rate-limit counters across instances via Upstash Redis (REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Comma-separated OAuth providers enabled in Supabase Auth (github, google, discord).
AUTH_OAUTH_PROVIDERS=github,google

# Early Access: `invite` closes public sign-up; /signup then links to the waitlist portal
# (early-access-portal/, which creates accounts for approved applicants). Leave empty for open sign-up.
# EARLY_ACCESS_URL is the portal's exact origin (e.g. https://early.diskarte.ph on Vercel).
SIGNUP_MODE=
EARLY_ACCESS_URL=http://localhost:3100

# --- Testing (optional) ----------------------------------------------------
# Base URL Playwright targets; defaults to http://localhost:3000.
E2E_BASE_URL=
