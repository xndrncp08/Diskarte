# =====================================================================
# Diskarte environment variables
# Copy to .env.local for `npm run dev`, or set them on your host (Render).
# All values are read at RUNTIME, so one Docker image works everywhere.
# =====================================================================

# --- Supabase (Project Settings → API) ---------------------------------
# Public project URL and anon/publishable key. Safe to expose to browsers;
# Row-Level Security in supabase/migrations protects the data.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# --- LiveKit (LiveKit Cloud → Settings → Keys) ---------------------------
# WebSocket URL of your LiveKit project (public).
LIVEKIT_URL=wss://your-project.livekit.cloud
# API key + secret used ONLY on the server to mint short-lived room tokens.
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- App -----------------------------------------------------------------
# Public base URL (used for OAuth redirects, invite links and OG metadata).
# On Render this falls back to RENDER_EXTERNAL_URL automatically.
SITE_URL=http://localhost:3000
# Optional comma-separated extra origins allowed to call /api/* (CORS + CSRF allow-list).
ALLOWED_ORIGINS=
# Optional rate limits (per client IP, per minute): auth attempts (default 5) and /api/* calls (default 120).
RATE_LIMIT_AUTH_PER_MINUTE=
RATE_LIMIT_API_PER_MINUTE=
# Optional: share rate-limit counters across instances via Upstash Redis (REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Comma-separated OAuth providers enabled in Supabase Auth (github, google, discord).
AUTH_OAUTH_PROVIDERS=github,google

# `invite` pauses public sign-up (/signup says registrations are closed). Leave empty for open sign-up.
SIGNUP_MODE=

# --- Privileged server integrations ---------------------------------------
# `npm run admin:grant -- you@example.com` makes the first Super Admin (Control Center access).
# Also used by the signed LiveKit webhook to invalidate live voice previews.
# Server-only. Never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push (optional; all five values + database setup required) --------
# Generate a stable key pair once with web-push.generateVAPIDKeys(). See docs/web-push.md.
# Public key is returned by the authenticated setup API; the private key stays server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A real operator contact (mailto:you@example.com or an HTTPS contact URL).
VAPID_SUBJECT=
# >=32 random characters; match the diskarte_push_secret stored in Supabase Vault.
PUSH_DISPATCH_SECRET=

# --- Testing (optional) ----------------------------------------------------
# Base URL Playwright targets; defaults to http://localhost:3000.
E2E_BASE_URL=

# Optional: GIF search in the message box (GIPHY API key from developers.giphy.com). Server-only;
# without it the GIF button says GIF search isn't set up.
GIPHY_API_KEY=
